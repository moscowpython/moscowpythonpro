# Copy to .env for local development. Never commit production secrets.
SECRET_KEY=local-development-only-change-before-deploy-75ab609743ed
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=sqlite:///db.sqlite3
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000
# For test deployments with an assigned hostname: True and an empty SITE_URL.
SITE_URL_FROM_REQUEST=False
TRUST_PROXY_SSL_HEADER=False
# Local Docker Compose database; override both in production.
POSTGRES_DB=moscowpythonpro
POSTGRES_USER=moscowpythonpro
POSTGRES_PASSWORD=local-development-only
# Optional test administrator. Both values are required; leave empty to skip.
DEFAULT_ADMIN_LOGIN=
DEFAULT_ADMIN_PASSWORD=
